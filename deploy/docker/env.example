# Copy this file to .env.docker. Keep credentials out of config.yaml and Git.
# The default DeepAgents/API configuration uses these two credentials.
ARK_API_KEY=
DEEPSEEK_API_KEY=
# Kimi Coding API: https://api.kimi.com/coding/v1
# Required when models.* selects kimi_coding (for example model: k3.1-pro).
# Setting a key does not switch models; see deploy/local-setup.md.
KIMI_API_KEY=

# Existing model YAML to import on FIRST launch only. Relative to the repo root.
# Runtime settings persist in app_data:/data/config/config.yaml thereafter.
SEEKINO_MODEL_CONFIG=./config.yaml

# Published ports; change these if a host development instance is already running.
SEEKINO_WEB_PORT=5173
SEEKINO_HTTP_PORT=9621
SEEKINO_MYSQL_PORT=3306
SEEKINO_ELASTICSEARCH_PORT=9200

# Optional worker capacity. Defaults are one task per phase in Docker.
# SEEKINO_VIDEO_CONCURRENCY=1
# SEEKINO_PARSE_CONCURRENCY=1
# SEEKINO_REFINE_CONCURRENCY=1
# SEEKINO_INDEX_CONCURRENCY=1
