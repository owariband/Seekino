# Copy to the server's private environment file and fill in the connection details.
# Use an independent production database, index, media root and API-backed model YAML.
ANIVAG_ENVIRONMENT=production
ANIVAG_AUTH_MODE=cloud
ANIVAG_PUBLIC_LIBRARY_ONLY=true
ANIVAG_PUBLIC_TENANT_ID=platform-public
ANIVAG_AUTH_COOKIE_SECURE=true
ANIVAG_AUTH_ADMIN_EMAILS=
ANIVAG_AUTH_SECRET_KEY=
ANIVAG_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
ANIVAG_DATABASE_URL=
ANIVAG_ELASTICSEARCH_URL=http://127.0.0.1:9200
ANIVAG_ELASTICSEARCH_INDEX=seekino_video_chunks_production
SEEKINO_ELASTICSEARCH_EVENT_INDEX=seekino_video_events_production_v3
ANIVAG_MODEL_CONFIG=/etc/seekino/models.yaml
ANIVAG_ARTIFACT_ROOT=/var/lib/seekino/artifacts
ANIVAG_LOG_DIRECTORY=/var/log/seekino
ANIVAG_HTTP_HOST=127.0.0.1
ANIVAG_HTTP_PORT=9621
ANIVAG_ALLOWED_ORIGINS=https://seekino.example.com
# The cloud YAML's total execution timeout must be shorter than this lease.
ANIVAG_AUTH_QUERY_LEASE_SECONDS=1800
ANIVAG_AUTH_QUERY_WINDOW_SECONDS=86400
ANIVAG_AUTH_QUERY_LIMIT_GUEST=10
ANIVAG_AUTH_QUERY_LIMIT_USER=30
ANIVAG_AUTH_CONCURRENT_QUERIES_GUEST=1
ANIVAG_AUTH_CONCURRENT_QUERIES_USER=1
ANIVAG_SMTP_HOST=
ANIVAG_SMTP_PORT=587
ANIVAG_SMTP_USERNAME=
ANIVAG_SMTP_PASSWORD=
ANIVAG_SMTP_SENDER=
ANIVAG_SMTP_START_TLS=true
ARK_API_KEY=
DEEPSEEK_API_KEY=
