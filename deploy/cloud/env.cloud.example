# Copy to deploy/cloud/.env.cloud on the server (ignored by Git) and fill in the values.
# Compose reads it twice: --env-file for interpolation and env_file for the API.
# compose.prod.yaml sets the environment, auth mode, database/Redis URLs, origin and model path.

# Host-side inputs
SEEKINO_PUBLIC_HOST=seekino.example.com
SEEKINO_TLS_CERT=/etc/seekino/tls/fullchain.pem
SEEKINO_TLS_KEY=/etc/seekino/tls/privkey.pem
# Server model YAML from models.example.yaml; it is mounted read-only into the API.
SEEKINO_MODEL_CONFIG=/etc/seekino/models.yaml
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SEEKINO_ELASTICSEARCH_INDEX=seekino_video_chunks_production
SEEKINO_ELASTICSEARCH_EVENT_INDEX=seekino_video_events_production_v3

# Identity and public library
SEEKINO_PUBLIC_LIBRARY_ONLY=true
SEEKINO_PUBLIC_TENANT_ID=platform-public
SEEKINO_AUTH_COOKIE_SECURE=true
SEEKINO_AUTH_ADMIN_EMAILS=
SEEKINO_AUTH_SECRET_KEY=
# The cloud YAML's total execution timeout must be shorter than this lease.
SEEKINO_AUTH_QUERY_LEASE_SECONDS=1800
SEEKINO_AUTH_QUERY_WINDOW_SECONDS=86400
# Retrieval and clip downloads share this per-IP daily guest budget.
SEEKINO_AUTH_QUERY_LIMIT_GUEST=10000
SEEKINO_AUTH_QUERY_LIMIT_USER=30
SEEKINO_AUTH_CONCURRENT_QUERIES_GUEST=4
SEEKINO_AUTH_CONCURRENT_QUERIES_USER=1

# E-mail login; leave SEEKINO_SMTP_HOST empty for a guest-only launch.
SEEKINO_SMTP_HOST=
SEEKINO_SMTP_PORT=587
SEEKINO_SMTP_USERNAME=
SEEKINO_SMTP_PASSWORD=
SEEKINO_SMTP_SENDER=
SEEKINO_SMTP_START_TLS=true

# Model API credentials, as required by the selected model YAML.
ARK_API_KEY=
DEEPSEEK_API_KEY=
# Required for the default Jev query router; the rewriter uses models.query_rewriter.
OPENROUTER_JEV_API_KEY=
# Kimi Coding API: https://api.kimi.com/coding/v1
# Required when models.* selects kimi_coding (for example model: k3.1-pro).
# Setting a key does not switch models; see deploy/local-setup.md.
KIMI_API_KEY=
