    {
      "id": "S1-body",
      "type": "text",
      "x": 76,
      "y": 1939,
      "width": 1064.8389892578125,
      "height": 117.76,
      "angle": 0,
      "strokeColor": "#50637a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
