      "customData": {
        "stageId": "G04A",
        "role": "field",
        "field": "function"
      },
      "text": "验证 SDK 候选和出口机制。分别观察调用返回、资源退出与进程退出；采用不在模型线程执行\n网络的有界隔离出口。",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "验证 SDK 候选和出口机制。分别观察调用返回、资源退出与进程退出；采用不在模型线程执行\n网络的有界隔离出口。",
      "autoResize": true,
      "lineHeight": 1.28
    },
