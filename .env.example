ARK_API_KEY=
DEEPSEEK_API_KEY=
# Kimi Coding API: https://api.kimi.com/coding/v1
# Required when models.* selects kimi_coding (for example model: k3.1-pro).
# Setting a key does not switch models; see deploy/local-setup.md.
KIMI_API_KEY=
# Optional local whisper.cpp: add an openai_audio source before selecting it.
# WHISPER_API_KEY=local-whisper
# Claude model source 的 auth_mode=api_key 时启用；local_subscription 不需要此项。
# ANTHROPIC_API_KEY=

# Server persistence. Keep development, test, and production in separate databases.
SEEKINO_ENVIRONMENT=development
# start.sh creates its own loopback MySQL with root / no password.
# Override this URL when using an existing authenticated MySQL instance.
SEEKINO_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/seekino_development?charset=utf8mb4
SEEKINO_DATABASE_POOL_RECYCLE_SECONDS=3600
# Native MySQL started by start.sh only; restart MySQL after changing this size.
# SEEKINO_MYSQL_BUFFER_POOL_SIZE=128M
# Elasticsearch is required by the default V2 mode. start.sh validates the cluster and index.
# Parse V2 writes released Chunk documents directly; API/Chat/search use Elasticsearch.
# No historical data migration or service cutover happens automatically.
SEEKINO_ELASTICSEARCH_URL=http://127.0.0.1:9200
SEEKINO_ELASTICSEARCH_INDEX=seekino_video_chunks_development
# Independent Event index; default: seekino_video_events_<environment>_v3 (description and each dialogue language encoded separately).
# Event target/config is frozen in VideoParseTask.detail on first INDEX, not ParseConfig.
SEEKINO_ELASTICSEARCH_EVENT_INDEX=seekino_video_events_development_v3
# Offline Event vision encoding samples; separate from interactive frame-tool display limits.
# Event image size inherits the shared SEEKINO_PARSE_MAX_HEIGHT, not an old task's Chunk size.
SEEKINO_EVENT_FRAME_FPS=1
SEEKINO_EVENT_MAX_FRAMES=3
# Increment this epoch before rebuilding unchanged content with a new index contract.
# SEEKINO_ELASTICSEARCH_INDEX_GENERATION=1
# SEEKINO_ELASTICSEARCH_API_KEY=
# SEEKINO_ELASTICSEARCH_PORT=9200
SEEKINO_TEXT_VECTOR_DIMENSIONS=1024
SEEKINO_VISION_VECTOR_DIMENSIONS=1024
SEEKINO_ARTIFACT_ROOT=outputs/server/artifacts

# Explicit trusted local mode keeps local-user / local-default and requires no login.
# Cloud requires a strong signing secret, Redis, SMTP and an HTTPS public origin.
# Start the optional local Redis dependency: docker compose --profile cloud-auth up -d redis
SEEKINO_AUTH_MODE=local
# Cloud sample-library launch: only administrators can upload and manage videos.
SEEKINO_PUBLIC_LIBRARY_ONLY=false
SEEKINO_LOCAL_TENANT_ID=local-default
SEEKINO_PUBLIC_TENANT_ID=platform-public
SEEKINO_AUTH_SECRET_KEY=
SEEKINO_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
SEEKINO_AUTH_REDIS_TIMEOUT_SECONDS=5
SEEKINO_REDIS_PORT=6379
SEEKINO_AUTH_COOKIE_NAME=seekino_auth
SEEKINO_AUTH_COOKIE_SECURE=true
SEEKINO_AUTH_TOKEN_TTL_SECONDS=604800
# Only verified new registrations matching this list receive the admin role.
SEEKINO_AUTH_ADMIN_EMAILS=

# Email OTP is held in Redis as an HMAC digest, never persisted on User or returned by the API.
SEEKINO_AUTH_OTP_TTL_SECONDS=300
SEEKINO_AUTH_OTP_ATTEMPT_LIMIT=5
SEEKINO_AUTH_SEND_COOLDOWN_SECONDS=60
SEEKINO_AUTH_SEND_WINDOW_SECONDS=3600
SEEKINO_AUTH_SEND_LIMIT_PER_EMAIL=5
SEEKINO_AUTH_SEND_LIMIT_PER_GUEST=10
SEEKINO_AUTH_SEND_LIMIT_PER_IP=30
SEEKINO_AUTH_VERIFY_WINDOW_SECONDS=300
SEEKINO_AUTH_VERIFY_LIMIT_PER_EMAIL=20
SEEKINO_AUTH_VERIFY_LIMIT_PER_GUEST=30
SEEKINO_AUTH_VERIFY_LIMIT_PER_IP=100
SEEKINO_AUTH_GUEST_WINDOW_SECONDS=3600
SEEKINO_AUTH_GUEST_LIMIT_PER_IP=30
SEEKINO_SMTP_HOST=
SEEKINO_SMTP_PORT=587
SEEKINO_SMTP_USERNAME=
SEEKINO_SMTP_PASSWORD=
SEEKINO_SMTP_SENDER=
SEEKINO_SMTP_USE_SSL=false
SEEKINO_SMTP_START_TLS=true
SEEKINO_SMTP_TIMEOUT_SECONDS=10

# Optional local mock inbox (no external delivery); see deploy/README.md.
SEEKINO_MAILPIT_SMTP_PORT=1025
SEEKINO_MAILPIT_WEB_PORT=8025
# Start with: docker compose --env-file .env.local --profile mock-email up -d --wait mailpit
# To use it, override the SMTP settings above in .env.local:
# SEEKINO_SMTP_HOST=127.0.0.1
# SEEKINO_SMTP_PORT=1025
# SEEKINO_SMTP_USERNAME=
# SEEKINO_SMTP_PASSWORD=
# SEEKINO_SMTP_SENDER=noreply@seekino.test
# SEEKINO_SMTP_USE_SSL=false
# SEEKINO_SMTP_START_TLS=false
# Read captured emails at http://127.0.0.1:8025 on the computer running Docker.

# Rolling request windows and concurrent executions; these are not Token-based billing limits.
# Guests share an IP budget, so replacing a guest identity does not reset the window.
SEEKINO_AUTH_QUERY_WINDOW_SECONDS=86400
SEEKINO_AUTH_QUERY_LIMIT_GUEST=20
SEEKINO_AUTH_QUERY_LIMIT_USER=200
SEEKINO_AUTH_CONCURRENT_QUERIES_GUEST=1
SEEKINO_AUTH_CONCURRENT_QUERIES_USER=3
# Agent execution_timeout_seconds must stay below this expiring lease.
SEEKINO_AUTH_QUERY_LEASE_SECONDS=600
SEEKINO_AUTH_GUEST_MAX_MODEL_CALLS=4

# Upload/API/MQ consumer defaults.
SEEKINO_HTTP_HOST=127.0.0.1
SEEKINO_HTTP_PORT=9621
SEEKINO_LOG_LEVEL=info
SEEKINO_LOG_DIRECTORY=outputs/server/logs
SEEKINO_LOG_MAX_BYTES=10485760
SEEKINO_LOG_BACKUP_COUNT=5
SEEKINO_WEB_PORT=5173
SEEKINO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SEEKINO_SSE_POLL_SECONDS=1
SEEKINO_SSE_KEEPALIVE_SECONDS=15
SEEKINO_UPLOAD_SEGMENT_SIZE_BYTES=8388608
SEEKINO_MAX_UPLOAD_SIZE_BYTES=10737418240
SEEKINO_MAX_IMAGE_UPLOAD_SIZE_BYTES=10485760
SEEKINO_MAX_IMAGE_PIXELS=40000000
SEEKINO_BACKGROUND_IMAGE_MAX_EDGE=1024
SEEKINO_UPLOAD_SESSION_TTL_SECONDS=86400
SEEKINO_UPLOAD_COMPLETION_STALE_SECONDS=900
SEEKINO_PIPELINE_VERSION=m2-seconds
# Formal execution supports only v2, using Video Parse V2 tasks and Elasticsearch.
# Apply the V2 MySQL migrations and configure SEEKINO_ELASTICSEARCH_URL/INDEX above.
SEEKINO_PARSE_EXECUTION_MODE=v2

# Server stores Token usage in model_usage using the existing MySQL connection.
# Local statistics do not require Langfuse. Optional tracing is disabled by default;
# retain these optional fields for configuration compatibility.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SEEKINO_PARSE_JOB_MAX_ATTEMPTS=3
SEEKINO_MQ_LEASE_SECONDS=300
SEEKINO_MQ_HEARTBEAT_SECONDS=60
SEEKINO_MQ_POLL_SECONDS=2
SEEKINO_MQ_RETRY_BASE_SECONDS=30
SEEKINO_MQ_RETRY_MAX_SECONDS=900
SEEKINO_CHUNK_DURATION_SECONDS=60
SEEKINO_CONTEXT_OVERLAP_SECONDS=3
SEEKINO_PARSE_MAX_HEIGHT=720
SEEKINO_ASR_CONCURRENCY=4
SEEKINO_ASR_MODE=lite
SEEKINO_PARSE_REQUEST_TIMEOUT_SECONDS=600
SEEKINO_MAX_CONTEXT_EVENTS=8
SEEKINO_MAX_CONTEXT_CHARS=2000

# Multi-Agent Query / Evaluator / Chat graph.
# All roles default to agent_model.model. Role overrides must name models that
# the selected agent_model.source can use. The fallback source is configured in
# config.yaml; this environment override changes only its model name.
# SEEKINO_AGENT_QUERY_MODEL=deepseek-flash
# SEEKINO_AGENT_EVALUATOR_MODEL=deepseek-flash
# SEEKINO_AGENT_CHAT_MODEL=deepseek-flash
# SEEKINO_AGENT_FALLBACK_MODEL=doubao-seed-2-0-lite-260428
# Global Agent runtime settings are in config.yaml (agent_runtime) and editable
# from Settings. Model role/connection settings are read at startup.
# Optional startup ceiling; omit it to use the model and agent_runtime budgets.
# SEEKINO_AGENT_REQUEST_TIMEOUT_SECONDS=120
# Legacy runtime overrides below only fill absent YAML fields; YAML takes precedence.
# Example legacy overrides when the matching YAML key is removed:
# SEEKINO_AGENT_STAGE_TIMEOUT_SECONDS=120
# SEEKINO_AGENT_EVALUATOR_STAGE_TIMEOUT_SECONDS=180
# SEEKINO_AGENT_EXECUTION_TIMEOUT_SECONDS=600
# SEEKINO_AGENT_MAX_TOOL_RESULT_BYTES=16384
# Catalogs use next_cursor for bounded pages; evidence/detail reads use an ID
# and a limited character range.

# Hybrid retrieval tuning, applied when the API starts.
SEEKINO_RETRIEVAL_SEARCH_DEFAULT_TOP_K=30
SEEKINO_RETRIEVAL_CHANNEL_TOP_K=20
SEEKINO_RETRIEVAL_RRF_K=60
# Used by the V2 Elasticsearch lexical channel.
SEEKINO_RETRIEVAL_LEXICAL_WEIGHT=1.0
SEEKINO_RETRIEVAL_TEXT_WEIGHT=1.0
SEEKINO_RETRIEVAL_VISION_WEIGHT=1.0

# Optional overrides; checked-in defaults live in config.yaml.
# SEEKINO_MODEL_CONFIG=/absolute/path/to/config.yaml
# SEEKINO_TRANSCRIPT_MODEL=ep-your-lite-endpoint
# SEEKINO_VIDEO_MODEL=ep-your-pro-endpoint
# SEEKINO_TRANSCRIPT_FPS=1.0
# SEEKINO_VIDEO_FPS=1.0
# SEEKINO_FALLBACK_ENABLED=true
# SEEKINO_VIDEO_EMBEDDING_MODEL=ep-your-embedding-endpoint
# SEEKINO_EMBEDDING_DIMENSIONS=1024
# SEEKINO_VIDEO_EMBEDDING_FPS=1.0

# Parse V2 service capacity; phase limits are frozen in each new task snapshot.
SEEKINO_VIDEO_CONCURRENCY=3
SEEKINO_PARSE_CONCURRENCY=10
SEEKINO_REFINE_CONCURRENCY=10
SEEKINO_INDEX_CONCURRENCY=10
SEEKINO_PARSE_EXECUTION_TIMEOUT_SECONDS=1800
SEEKINO_REFINE_EXECUTION_TIMEOUT_SECONDS=1800
SEEKINO_INDEX_EXECUTION_TIMEOUT_SECONDS=1800
SEEKINO_MAX_MODEL_CALLS=100
