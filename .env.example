ARK_API_KEY=
DEEPSEEK_API_KEY=
# Claude model source 的 auth_mode=api_key 时启用；local_subscription 不需要此项。
# ANTHROPIC_API_KEY=

# Server persistence. Keep development, test, and production in separate databases.
ANIVAG_ENVIRONMENT=development
# start.sh creates its own loopback MySQL with root / no password.
# Override this URL when using an existing authenticated MySQL instance.
ANIVAG_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/anivag_development?charset=utf8mb4
ANIVAG_DATABASE_POOL_RECYCLE_SECONDS=3600
# Elasticsearch is required by the default V2 mode. start.sh validates the cluster and index.
# Parse V2 writes released Chunk documents directly; API/Chat/search use Elasticsearch.
# No historical data migration or service cutover happens automatically.
ANIVAG_ELASTICSEARCH_URL=http://127.0.0.1:9200
ANIVAG_ELASTICSEARCH_INDEX=anivag_video_chunks_development
# Independent Event index; default: seekino_video_events_<environment>_v1.
# Event target/config is frozen in VideoParseTask.detail on first INDEX, not ParseConfig.
SEEKINO_ELASTICSEARCH_EVENT_INDEX=seekino_video_events_development_v1
# Offline Event vision encoding samples; separate from interactive frame-tool display limits.
# Event image size inherits the shared ANIVAG_PARSE_MAX_HEIGHT, not an old task's Chunk size.
SEEKINO_EVENT_FRAME_FPS=1
SEEKINO_EVENT_MAX_FRAMES=3
# Increment this epoch before rebuilding unchanged content with a new index contract.
# ANIVAG_ELASTICSEARCH_INDEX_GENERATION=1
# ANIVAG_ELASTICSEARCH_API_KEY=
# ANIVAG_ELASTICSEARCH_PORT=9200
ANIVAG_TEXT_VECTOR_DIMENSIONS=1024
ANIVAG_VISION_VECTOR_DIMENSIONS=1024
ANIVAG_ARTIFACT_ROOT=outputs/server/artifacts

# Explicit trusted local mode keeps local-user / local-default and requires no login.
# Cloud requires a strong signing secret, Redis, SMTP and an HTTPS public origin.
# Start the optional local Redis dependency: docker compose --profile cloud-auth up -d redis
ANIVAG_AUTH_MODE=local
ANIVAG_LOCAL_TENANT_ID=local-default
ANIVAG_PUBLIC_TENANT_ID=platform-public
ANIVAG_AUTH_SECRET_KEY=
ANIVAG_AUTH_REDIS_URL=redis://127.0.0.1:6379/0
ANIVAG_AUTH_REDIS_TIMEOUT_SECONDS=5
ANIVAG_REDIS_PORT=6379
ANIVAG_AUTH_COOKIE_NAME=anivag_auth
ANIVAG_AUTH_COOKIE_SECURE=true
ANIVAG_AUTH_TOKEN_TTL_SECONDS=604800
# Only verified new registrations matching this list receive the admin role.
ANIVAG_AUTH_ADMIN_EMAILS=

# Email OTP is held in Redis as an HMAC digest, never persisted on User or returned by the API.
ANIVAG_AUTH_OTP_TTL_SECONDS=300
ANIVAG_AUTH_OTP_ATTEMPT_LIMIT=5
ANIVAG_AUTH_SEND_COOLDOWN_SECONDS=60
ANIVAG_AUTH_SEND_WINDOW_SECONDS=3600
ANIVAG_AUTH_SEND_LIMIT_PER_EMAIL=5
ANIVAG_AUTH_SEND_LIMIT_PER_GUEST=10
ANIVAG_AUTH_SEND_LIMIT_PER_IP=30
ANIVAG_AUTH_VERIFY_WINDOW_SECONDS=300
ANIVAG_AUTH_VERIFY_LIMIT_PER_EMAIL=20
ANIVAG_AUTH_VERIFY_LIMIT_PER_GUEST=30
ANIVAG_AUTH_VERIFY_LIMIT_PER_IP=100
ANIVAG_AUTH_GUEST_WINDOW_SECONDS=3600
ANIVAG_AUTH_GUEST_LIMIT_PER_IP=30
ANIVAG_SMTP_HOST=
ANIVAG_SMTP_PORT=587
ANIVAG_SMTP_USERNAME=
ANIVAG_SMTP_PASSWORD=
ANIVAG_SMTP_SENDER=
ANIVAG_SMTP_USE_SSL=false
ANIVAG_SMTP_START_TLS=true
ANIVAG_SMTP_TIMEOUT_SECONDS=10

# Rolling request windows and concurrent executions; these are not Token-based billing limits.
# Guests share an IP budget, so replacing a guest identity does not reset the window.
ANIVAG_AUTH_QUERY_WINDOW_SECONDS=86400
ANIVAG_AUTH_QUERY_LIMIT_GUEST=20
ANIVAG_AUTH_QUERY_LIMIT_USER=200
ANIVAG_AUTH_CONCURRENT_QUERIES_GUEST=1
ANIVAG_AUTH_CONCURRENT_QUERIES_USER=3
# Agent execution_timeout_seconds must stay below this expiring lease.
ANIVAG_AUTH_QUERY_LEASE_SECONDS=600
ANIVAG_AUTH_GUEST_MAX_MODEL_CALLS=4

# Upload/API/MQ consumer defaults.
ANIVAG_HTTP_HOST=127.0.0.1
ANIVAG_HTTP_PORT=9621
ANIVAG_LOG_LEVEL=info
ANIVAG_LOG_DIRECTORY=outputs/server/logs
ANIVAG_LOG_MAX_BYTES=10485760
ANIVAG_LOG_BACKUP_COUNT=5
ANIVAG_WEB_PORT=5173
ANIVAG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ANIVAG_SSE_POLL_SECONDS=1
ANIVAG_SSE_KEEPALIVE_SECONDS=15
ANIVAG_UPLOAD_SEGMENT_SIZE_BYTES=8388608
ANIVAG_MAX_UPLOAD_SIZE_BYTES=10737418240
ANIVAG_MAX_IMAGE_UPLOAD_SIZE_BYTES=10485760
ANIVAG_MAX_IMAGE_PIXELS=40000000
ANIVAG_BACKGROUND_IMAGE_MAX_EDGE=1024
ANIVAG_UPLOAD_SESSION_TTL_SECONDS=86400
ANIVAG_UPLOAD_COMPLETION_STALE_SECONDS=900
ANIVAG_PIPELINE_VERSION=m2-seconds
# Formal execution supports only v2, using Video Parse V2 tasks and Elasticsearch.
# Apply the V2 MySQL migrations and configure ANIVAG_ELASTICSEARCH_URL/INDEX above.
ANIVAG_PARSE_EXECUTION_MODE=v2

# Server stores Token usage in model_usage using the existing MySQL connection.
# Local statistics do not require Langfuse. Optional tracing is disabled by default;
# retain these optional fields for configuration compatibility.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ANIVAG_PARSE_JOB_MAX_ATTEMPTS=3
ANIVAG_MQ_LEASE_SECONDS=300
ANIVAG_MQ_HEARTBEAT_SECONDS=60
ANIVAG_MQ_POLL_SECONDS=2
ANIVAG_MQ_RETRY_BASE_SECONDS=30
ANIVAG_MQ_RETRY_MAX_SECONDS=900
ANIVAG_CHUNK_DURATION_SECONDS=60
ANIVAG_CONTEXT_OVERLAP_SECONDS=3
ANIVAG_PARSE_MAX_HEIGHT=720
ANIVAG_ASR_CONCURRENCY=4
ANIVAG_ASR_MODE=lite
ANIVAG_PARSE_REQUEST_TIMEOUT_SECONDS=600
ANIVAG_MAX_CONTEXT_EVENTS=8
ANIVAG_MAX_CONTEXT_CHARS=2000

# Multi-Agent Query / Evaluator / Chat graph.
# All roles default to agent_model.model. Role overrides must name models that
# the selected agent_model.source can use. The fallback source is configured in
# config.yaml; this environment override changes only its model name.
# ANIVAG_AGENT_QUERY_MODEL=deepseek-flash
# ANIVAG_AGENT_EVALUATOR_MODEL=deepseek-flash
# ANIVAG_AGENT_CHAT_MODEL=deepseek-flash
# ANIVAG_AGENT_FALLBACK_MODEL=doubao-seed-2-0-lite-260428
# Global Agent runtime settings are in config.yaml (agent_runtime) and editable
# from Settings. Model role/connection settings are read at startup.
# Optional startup ceiling; omit it to use the model and agent_runtime budgets.
# ANIVAG_AGENT_REQUEST_TIMEOUT_SECONDS=120
# Legacy runtime overrides below only fill absent YAML fields; YAML takes precedence.
# Example legacy overrides when the matching YAML key is removed:
# ANIVAG_AGENT_STAGE_TIMEOUT_SECONDS=120
# ANIVAG_AGENT_EVALUATOR_STAGE_TIMEOUT_SECONDS=180
# ANIVAG_AGENT_EXECUTION_TIMEOUT_SECONDS=600
# ANIVAG_AGENT_MAX_TOOL_RESULT_BYTES=16384
# Catalogs use next_cursor for bounded pages; evidence/detail reads use an ID
# and a limited character range.

# Hybrid retrieval tuning, applied when the API starts.
ANIVAG_RETRIEVAL_SEARCH_DEFAULT_TOP_K=30
ANIVAG_RETRIEVAL_CHANNEL_TOP_K=20
ANIVAG_RETRIEVAL_RRF_K=60
# Used by the V2 Elasticsearch lexical channel.
ANIVAG_RETRIEVAL_LEXICAL_WEIGHT=1.0
ANIVAG_RETRIEVAL_TEXT_WEIGHT=1.0
ANIVAG_RETRIEVAL_VISION_WEIGHT=1.0

# Optional overrides; checked-in defaults live in config.yaml.
# ANIVAG_MODEL_CONFIG=/absolute/path/to/config.yaml
# ANIVAG_TRANSCRIPT_MODEL=ep-your-lite-endpoint
# ANIVAG_VIDEO_MODEL=ep-your-pro-endpoint
# ANIVAG_TRANSCRIPT_FPS=1.0
# ANIVAG_VIDEO_FPS=1.0
# ANIVAG_FALLBACK_ENABLED=true
# ANIVAG_VIDEO_EMBEDDING_MODEL=ep-your-embedding-endpoint
# ANIVAG_EMBEDDING_DIMENSIONS=1024
# ANIVAG_VIDEO_EMBEDDING_FPS=1.0

# Parse V2 service capacity; phase limits are frozen in each new task snapshot.
ANIVAG_VIDEO_CONCURRENCY=3
ANIVAG_PARSE_CONCURRENCY=10
ANIVAG_REFINE_CONCURRENCY=10
ANIVAG_INDEX_CONCURRENCY=10
ANIVAG_PARSE_EXECUTION_TIMEOUT_SECONDS=1800
ANIVAG_REFINE_EXECUTION_TIMEOUT_SECONDS=1800
ANIVAG_INDEX_EXECUTION_TIMEOUT_SECONDS=1800
ANIVAG_MAX_MODEL_CALLS=100
