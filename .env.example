ARK_API_KEY=
DEEPSEEK_API_KEY=

# Server persistence. Keep development, test, and production in separate databases.
ANIVAG_ENVIRONMENT=development
# start.sh creates its own loopback MySQL with root / no password.
# Override this URL when using an existing authenticated MySQL instance.
ANIVAG_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/anivag_development?charset=utf8mb4
ANIVAG_DATABASE_POOL_RECYCLE_SECONDS=3600
ANIVAG_QDRANT_URL=http://127.0.0.1:6333
ANIVAG_QDRANT_COLLECTION=anivag_video_chunks_development
ANIVAG_TEXT_VECTOR_DIMENSIONS=1024
ANIVAG_VISION_VECTOR_DIMENSIONS=1024
ANIVAG_ARTIFACT_ROOT=outputs/server/artifacts
# ANIVAG_QDRANT_API_KEY=

# Upload/API/MQ consumer defaults.
ANIVAG_HTTP_HOST=127.0.0.1
ANIVAG_HTTP_PORT=9621
ANIVAG_LOG_LEVEL=info
ANIVAG_LOG_DIRECTORY=outputs/server/logs
ANIVAG_LOG_MAX_BYTES=10485760
ANIVAG_LOG_BACKUP_COUNT=5
ANIVAG_WEB_PORT=5173
ANIVAG_QDRANT_GRPC_PORT=6334
ANIVAG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ANIVAG_SSE_POLL_SECONDS=1
ANIVAG_SSE_KEEPALIVE_SECONDS=15
ANIVAG_UPLOAD_SEGMENT_SIZE_BYTES=8388608
ANIVAG_MAX_UPLOAD_SIZE_BYTES=10737418240
ANIVAG_MAX_IMAGE_UPLOAD_SIZE_BYTES=10485760
ANIVAG_MAX_IMAGE_PIXELS=40000000
ANIVAG_BACKGROUND_IMAGE_MAX_EDGE=1024
ANIVAG_UPLOAD_SESSION_TTL_SECONDS=86400
ANIVAG_UPLOAD_COMPLETION_STALE_SECONDS=900
ANIVAG_PIPELINE_VERSION=m1
ANIVAG_PARSE_JOB_MAX_ATTEMPTS=3
ANIVAG_MQ_LEASE_SECONDS=300
ANIVAG_MQ_HEARTBEAT_SECONDS=60
ANIVAG_MQ_POLL_SECONDS=2
ANIVAG_MQ_RETRY_BASE_SECONDS=30
ANIVAG_MQ_RETRY_MAX_SECONDS=900
ANIVAG_INDEX_SYNC_RETRY_BASE_SECONDS=30
ANIVAG_INDEX_SYNC_RETRY_MAX_SECONDS=900
ANIVAG_CHUNK_DURATION_MS=60000
ANIVAG_CONTEXT_OVERLAP_MS=3000
ANIVAG_PARSE_MAX_HEIGHT=720
ANIVAG_ASR_CONCURRENCY=4
ANIVAG_ASR_MODE=lite
ANIVAG_PARSE_REQUEST_TIMEOUT_SECONDS=600
ANIVAG_MAX_CONTEXT_EVENTS=8
ANIVAG_MAX_CONTEXT_CHARS=2000

# Multi-Agent Chat / Evaluator graph.
# Defaults to video_parser.transcript_model when omitted.
# ANIVAG_AGENT_CHAT_MODEL=doubao-seed-2-0-lite-260428
# ANIVAG_AGENT_EVALUATOR_MODEL=doubao-seed-2-0-lite-260428
ANIVAG_AGENT_REQUEST_TIMEOUT_SECONDS=180
ANIVAG_AGENT_HISTORY_MESSAGE_LIMIT=12
ANIVAG_AGENT_DEFAULT_TOP_K=8
ANIVAG_AGENT_MAX_TOP_K=20

# Hybrid retrieval tuning, applied when the API starts.
ANIVAG_RETRIEVAL_CHANNEL_TOP_K=20
ANIVAG_RETRIEVAL_RRF_K=60
ANIVAG_RETRIEVAL_TEXT_WEIGHT=1.0
ANIVAG_RETRIEVAL_VISION_WEIGHT=1.0

# Optional overrides; checked-in defaults live in config.yaml.
# ANIVAG_MODEL_CONFIG=/absolute/path/to/config.yaml
# ANIVAG_MODEL_PRICING_CONFIG=/absolute/path/to/config/model-pricing.yaml
# ANIVAG_TRANSCRIPT_MODEL=ep-your-lite-endpoint
# ANIVAG_VIDEO_MODEL=ep-your-pro-endpoint
# ANIVAG_TRANSCRIPT_FPS=1.0
# ANIVAG_VIDEO_FPS=1.0
# ANIVAG_FALLBACK_ENABLED=true
# ANIVAG_VIDEO_EMBEDDING_MODEL=ep-your-embedding-endpoint
# ANIVAG_EMBEDDING_DIMENSIONS=1024
# ANIVAG_VIDEO_EMBEDDING_FPS=1.0
