  {
   "id": "TDSheJpmr1LeWG988EQ9F",
   "type": "text",
   "x": 30,
   "y": 880,
   "width": 744.25048828125,
   "height": 20.25,
   "angle": 0,
   "strokeColor": "#6B7280",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ag",
   "roundness": null,
   "seed": 2096667169,
   "version": 2,
   "versionNonce": 1371106145,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794389041639,
   "link": null,
   "locked": false,
   "text": "Calls only go downward. Each layer's right column says what it must not do; fixes land in the layer that owns the behaviour.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Calls only go downward. Each layer's right column says what it must not do; fixes land in the layer that owns the behaviour.",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
   "id": "DpfPPz_Wnu8ppaXTIrWZv",
   "type": "text",
   "x": 10,
   "y": 920,
   "width": 1075.4658203125,
   "height": 45.900000000000006,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ah",
   "roundness": null,
   "seed": 1611551855,
   "version": 2,
   "versionNonce": 1366177583,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794389041639,
   "link": null,
   "locked": false,
   "text": "Figure 7. Repository layers. web/ talks to server/ over HTTP; server/ owns state, permissions and reliable execution and hosts agent/ with an injected runtime;\nagent/ decides how models are used; engine/ holds the algorithms and contracts; gateway/ talks to providers without knowing what a video is.",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Figure 7. Repository layers. web/ talks to server/ over HTTP; server/ owns state, permissions and reliable execution and hosts agent/ with an injected runtime;\nagent/ decides how models are used; engine/ holds the algorithms and contracts; gateway/ talks to providers without knowing what a video is.",
   "autoResize": true,
   "lineHeight": 1.35
  },
