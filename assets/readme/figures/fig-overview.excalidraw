   "roundness": null,
   "seed": 828911478,
   "version": 2,
   "versionNonce": 1311407402,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794388758054,
   "link": null,
   "locked": false,
   "text": "Figure 2. Seekino overview. A video is parsed once into versioned Events in MySQL and projected into Elasticsearch. A question is routed, retrieved inside the\ncaller's scope and checked against the source timeline before the answer and its clip cards stream back. External agents reach the same retrieval through MCP.",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Figure 2. Seekino overview. A video is parsed once into versioned Events in MySQL and projected into Elasticsearch. A question is routed, retrieved inside the\ncaller's scope and checked against the source timeline before the answer and its clip cards stream back. External agents reach the same retrieval through MCP.",
   "autoResize": true,
   "lineHeight": 1.35
  },
