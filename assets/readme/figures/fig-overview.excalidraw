  {
   "id": "WA1gQ1k4nNCJAEWQDJwHZ",
   "type": "text",
   "x": 10,
   "y": 730,
   "width": 1084.74609375,
   "height": 45.900000000000006,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
