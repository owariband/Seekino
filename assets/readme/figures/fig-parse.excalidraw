  {
   "id": "-ERiCMRZ7HIMLopH4_s_D",
   "type": "text",
   "x": 10,
   "y": 885,
   "width": 1242.427734375,
   "height": 45.900000000000006,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "av",
   "roundness": null,
   "seed": 89381256,
   "version": 2,
   "versionNonce": 678546568,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794388854467,
   "link": null,
   "locked": false,
   "text": "Figure 4. Parse V2. A video is cut into fixed 60 s chunks and understood in parallel, so wall time grows with chunks ÷ concurrency instead of video length.\nRefine re-reads 3-chunk windows to repair the cuts; overlapping windows are resolved optimistically. Every stage commits to MySQL, and a retry resumes from what was committed.",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Figure 4. Parse V2. A video is cut into fixed 60 s chunks and understood in parallel, so wall time grows with chunks ÷ concurrency instead of video length.\nRefine re-reads 3-chunk windows to repair the cuts; overlapping windows are resolved optimistically. Every stage commits to MySQL, and a retry resumes from what was committed.",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
   "id": "QqCi-DSwinGnVu27Y09gM",
