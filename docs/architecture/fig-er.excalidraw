   "isDeleted": false,
   "boundElements": null,
   "updated": 1794389109630,
   "link": null,
   "locked": false,
   "text": "Solid border: MySQL table (business fact).\nTeal: Elasticsearch, derived and rebuildable.\nThick border: the Event timeline that\nsearch and answers are checked against.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Solid border: MySQL table (business fact).\nTeal: Elasticsearch, derived and rebuildable.\nThick border: the Event timeline that\nsearch and answers are checked against.",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
   "id": "pfNnRRx6oEx_TuuQis_zM",
   "type": "text",
   "x": 10,
   "y": 860,
   "width": 1025.28759765625,
   "height": 45.900000000000006,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ap",
   "roundness": null,
   "seed": 876434165,
   "version": 2,
   "versionNonce": 1390119605,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794389109630,
   "link": null,
   "locked": false,
   "text": "Figure 3. Data model. MySQL owns facts, tasks and versions; every parse writes a new content version per chunk.\nElasticsearch keeps one derived document per chunk, keyed by task and chunk, so a hit can be checked back against the exact version that produced it.",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Figure 3. Data model. MySQL owns facts, tasks and versions; every parse writes a new content version per chunk.\nElasticsearch keeps one derived document per chunk, keyed by task and chunk, so a hit can be checked back against the exact version that produced it.",
   "autoResize": true,
   "lineHeight": 1.35
  },
