   "isDeleted": false,
   "boundElements": null,
   "updated": 1794389042286,
   "link": null,
   "locked": false,
   "text": "Figure 6. Chat. Every turn first decides whether it needs a search at all, and rewrites only the part that does. The Supervisor reads outlines, delegates retrieval to a\nvideo search agent, or looks at the current frame. Answers stream as they are written, and every clip card points back to a checked range in the source video.",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Figure 6. Chat. Every turn first decides whether it needs a search at all, and rewrites only the part that does. The Supervisor reads outlines, delegates retrieval to a\nvideo search agent, or looks at the current frame. Answers stream as they are written, and every clip card points back to a checked range in the source video.",
   "autoResize": true,
   "lineHeight": 1.35
  },
