="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c116" value="" style="rounded=0;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#E3E7ED;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=26;fontStyle=1;fontColor=#1F3A5F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1760" height="1180" as="geometry"/></mxCell><mxCell id="c117" value="&lt;b&gt;Figure 3.&lt;/b&gt; Seekino overview. &lt;b&gt;Left:&lt;/b&gt; runtime layers and who owns what — business state and transactions live in Server; Engine owns schemas, time rules and retrieval algorithms; Gateway is provider-agnostic. &lt;b&gt;Right:&lt;/b&gt; the material memory is &lt;b&gt;constructed&lt;/b&gt; once per video (Parse V2), &lt;b&gt;retrieved&lt;/b&gt; per query inside the authorized scope, and every answer is &lt;b&gt;grounded&lt;/b&gt; back to the source timeline before it is shown. MySQL holds facts and versions; Elasticsearch only holds a derived projection that can be rebuilt." style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=17;fontFamily=Times New Roman;fontStyle=0;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="1760" height="60" as="geometry"/></mxCell><mxCell id="c118" value="Seekino runtime" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1F3A5F;fontSize=30;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c116"><mxGeometry x="24" y="14" width="600" height="50" as="geometry"/></mxCell><mxCell id="c119" value="Video material memory" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1F3A5F;fontSize=30;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2