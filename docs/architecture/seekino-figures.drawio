as="points"><mxPoint x="1175" y="96"/><mxPoint x="1620" y="96"/></Array></mxGeometry></mxCell><mxCell id="c667" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#2A9D9F;strokeWidth=2;fontColor=#2A9D9F;fontSize=14;fontStyle=1;fontFamily=Helvetica;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="c621" source="c657" target="c661"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c668" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8A94A6;strokeWidth=1.2;fontColor=#8A94A6;fontSize=14;fontStyle=1;fontFamily=Helvetica;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="c621" source="c647" target="c648"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c669" value="&lt;b&gt;retrieval_query&lt;/b&gt; rules: keep the quoted line verbatim (with negation and limits) · no guessing names, episodes or plot · only the search part of &lt;i&gt;mixed&lt;/i&gt; · &lt;b&gt;null&lt;/b&gt; if unresolved · ≤160 chars" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E6;strokeWidth=1.5;fontColor=#2B2B2B;fontSize=13;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c621"><mxGeometry x="860" y="252" width="600" height="92" as="geometry"/></mxCell><mxCell id="c670" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.2;fontColor=#2B2B2B;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c621"><mxGeometry x="860" y="368" width="600" height="236" as="geometry"/></mxCell><mxCell id="c671" value="What ③ hands the supervisor (example: a &lt;i&gt;respond&lt;/i&gt; turn)" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8A94A6;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="374" width="560" height="26" as="geometry"/></mxCell><mxCell id="c672" value="你这回答也太高高在上了吧。  &lt;font color='#8A94A6'&gt;← user text, unchanged&lt;/font&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="404" width="570" height="36" as="geometry"/></mxCell><mxCell id="c673" value="&lt;font color='#2E9E5B'&gt;[本轮处理说明｜应用生成]&lt;/font&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="442" width="570" height="36" as="geometry"/></mxCell><mxCell id="c674" value="简单回应：本轮不涉及新的检索任务。先理解用户当前在说什么、评价或吐槽什么，再直接回应。…" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="480" width="570" height="36" as="geometry"/></mxCell><mxCell id="c675" value="本说明仅适用于当前消息，不评价上一轮检索是否正确，也不约束后续轮次。…" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="518" width="570" height="36" as="geometry"/></mxCell><mxCell id="c676" value="&lt;font color='#2E9E5B'&gt;[/本轮处理说明]&lt;/font&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Courier New;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="876" y="556" width="570" height="36" as="geometry"/></mxCell><mxCell id="c677" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;retrieve – verify loop&lt;br&gt;→ submit_video_item&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D9E7F8;strokeColor=#3A7BD5;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=17;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c621"><mxGeometry x="1500" y="420" width="220" height="120" as="geometry"/></mxCell><mxCell id="c678" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#2E9E5B;strokeWidth=2;fontColor=#2E9E5B;fontSize=14;fontStyle=1;fontFamily=Helvetica;dashed=0;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="c621" source="c661" target="c677"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c679" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#2E9E5B;strokeWidth=1.2;fontColor=#2E9E5B;fontSize=14;fontStyle=1;fontFamily=Helvetica;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="c621" source="c670" target="c677"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c680" value="fail open → raw message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8A94A6;strokeWidth=1.2;fontColor=#8A94A6;fontSize=14;fontStyle=1;fontFamily=Helvetica;dashed=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="c621" source="c648" target="c677"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="289"/><mxPoint x="610" y="618"/><mxPoint x="1610" y="618"/></Array></mxGeometry></mxCell><mxCell id="c681" value="&lt;b&gt;8 s total budget.&lt;/b&gt; Timeout, provider error or invalid schema → raw message. Cancellation and quota rejection are raised, not swallowed.&lt;br&gt;&lt;br&gt;&lt;font color='#8A94A6'&gt;Alt binding: the chat model decides action + query in one call.&lt;/font&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=13;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="c621"><mxGeometry x="620" y="350" width="220" height="250" as="geometry"/></mxCell><mxCell id="c682" value="" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E6;strokeWidth=1.5;fontColor=#2B2B2B;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c621"><mxGeometry x="20" y="656" width="1720" height="450" as="geometry"/></mxCell><mxCell id="c683" value="(c) Routing A/B  &lt;font color='#8A94A6' style='font-size:14px'&gt;same scenarios, supervisor, tools and data per arm · values TODO, re-measure on the current build&lt;/font&gt;" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1F3A5F;fontSize=18;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="40" y="666" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c684" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#3A7BD5;strokeColor=none;strokeWidth=1.5;fontColor=#2B2B2B;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c621"><mxGeometry x="50" y="712" width="22" height="16" as="geometry"/></mxCell><mxCell id="c685" value="Jev + DS Flash" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c621"><mxGeometry x="78" y="706" width="200" height="28" as="geometry"/></mxCell><mxCell id="c686" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#A