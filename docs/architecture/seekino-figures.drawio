fontSize=15;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c338"><mxGeometry x="900" y="600" width="400" height="76" as="geometry"/></mxCell><mxCell id="c425" value="&lt;b&gt;content version&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A6475'&gt;Refine / Index commit only on the version they read&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E6;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c338"><mxGeometry x="1314" y="600" width="400" height="76" as="geometry"/></mxCell><mxCell id="c426" value="&lt;b&gt;idempotent receipt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A6475'&gt;a second worker cannot re-claim a committed range&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E6;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c338"><mxGeometry x="900" y="688" width="400" height="76" as="geometry"/></mxCell><mxCell id="c427" value="&lt;b&gt;artifact reuse&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5A6475'&gt;transcript &amp; speaker groups survive downstream failure&lt;/font&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E6;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c338"><mxGeometry x="1314" y="688" width="400" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="fig06" name="06 Fixed chunks + parallel"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c428" value="" style="rounded=0;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#E3E7ED;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=26;fontStyle=1;fontColor=#1F3A5F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1760" height="1330" as="geometry"/></mxCell><mxCell id="c429" value="&lt;b&gt;Figure 6.&lt;/b&gt; Fixed-size chunks, parsed in parallel. &lt;b&gt;(a)&lt;/b&gt; The video is cut on a fixed 60 s grid (integer ms, left-closed right-open); the transcript is produced once for the whole video and sliced per chunk. &lt;b&gt;(b)&lt;/b&gt; Understanding sees ±3 s of neighbour frames for context but may only emit events inside its own chunk. &lt;b&gt;(c)&lt;/b&gt; Refine windows of 3 chunks slide by one, so a line cut by a boundary is seen whole; a chunk is indexed once every window covering it has committed. &lt;b&gt;(d)&lt;/b&gt; Up to 10 chunks run at once; the next batch of 10 opens when 90% of the previous batch has committed. Schedule in (d) is illustrative (rules from &lt;font face='Courier New'&gt;scheduler.py&lt;/font&gt;); durations are not measured." style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B2B2B;fontSize=17;fontFamily=Times New Roman;fontStyle=0;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1760" height="60" as="geometry"/></mxCell><mxCell id="c430" value="Fixed-size chunks, parsed in parallel" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1F3A5F;fontSize=30;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c428"><mxGeometry x="24" y="14" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c431" value="(a) Fixed grid" style="text=1;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1F3A5F;fontSize=20;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="c428"><mxGeometry x="24" y="74" width="200" height="30" as="geometry"/></mxCell><mxCell id="c432" value="Whole-video ASR, once · whisper.cpp turbo · persisted, reused by retries" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#DDF0F0;strokeColor=#2A9D9F;strokeWidth=1.5;fontColor=#145E60;fontSize=15;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c428"><mxGeometry x="230" y="76" width="1368" height="34" as="geometry"/></mxCell><mxCell id="c433" value="0" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D9E7F8;strokeColor=none;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c428"><mxGeometry x="230" y="126" width="48" height="56" as="geometry"/></mxCell><mxCell id="c434" value="1" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D9E7F8;strokeColor=none;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c428"><mxGeometry x="282" y="126" width="48" height="56" as="geometry"/></mxCell><mxCell id="c435" value="2" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D9E7F8;strokeColor=none;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacing=8;dashed=0;" vertex="1" parent="c428"><mxGeometry x="334" y="126" width="48" height="56" as="geometry"/></mxCell><mxCell id="c436" value="3" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#D9E7F8;strokeColor=none;strokeWidth=1.5;fontColor=#1F3A5F;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=ce