    {
      "id": "pm-012ed9c8d2a44d05a",
      "type": "text",
      "x": 3850,
      "y": 2304.1999999999994,
      "width": 913,
      "height": 117.6,
      "angle": 0,
      "strokeColor": "#1e293b",
