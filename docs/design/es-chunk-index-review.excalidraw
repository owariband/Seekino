    },
    {
      "id": "9a45e2ba2b374dda",
      "type": "text",
      "x": 1200,
      "y": 6423,
      "width": 512.0,
      "height": 117.6,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "a99576f128b240de"
      ],
      "frameId": "ade42743521a4dc2",
      "roundness": null,
      "seed": 1944,
      "version": 2,
      "versionNonce": 606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790658895521,
      "created": 1790607854110,
      "link": null,
      "locked": false,
      "text": "只改 questions / keywords：文字与视频向量可复用。\n改对白：文字输入变更需编码，媒体未变可复用视频。\n改视频采样 / 编码模型：视频向量重新生成。\n不因全局索引指纹变化而一概重算两个模型。",
      "originalText": "只改 questions / keywords：文字与视频向量可复用。\n改对白：文字输入变更需编码，媒体未变可复用视频。\n改视频采样 / 编码模型：视频向量重新生成。\n不因全局索引指纹变化而一概重算两个模型。",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
