    {
      "id": "6309994c283b45a9",
      "type": "text",
      "x": 1160,
      "y": 5396,
      "width": 579.0,
      "height": 160.99999999999997,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
