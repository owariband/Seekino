      ],
      "frameId": "ec133c67461641e2",
      "roundness": null,
      "seed": 8142,
      "version": 1,
      "versionNonce": 412,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790658895521,
      "created": 1790658895521,
      "link": null,
      "locked": false,
      "text": "只有生成问题命中；或台词是别人在说 → 不满足。\n要求中文原声，但只有日语原声/中文译文 → 不满足。\nES v12 / MySQL v13；任务重建或删除 → 丢弃旧候选。\n模型高分不能越过这些条件。\n预算内展开或补搜，仍缺证据则不冒充命中。",
      "originalText": "只有生成问题命中；或台词是别人在说 → 不满足。\n要求中文原声，但只有日语原声/中文译文 → 不满足。\nES v12 / MySQL v13；任务重建或删除 → 丢弃旧候选。\n模型高分不能越过这些条件。\n预算内展开或补搜，仍缺证据则不冒充命中。",
      "fontSize": 23,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.4
