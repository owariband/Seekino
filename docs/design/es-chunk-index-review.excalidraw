    {
      "id": "ef9076af446a4e05",
      "type": "text",
      "x": 60,
      "y": 6423,
      "width": 513.0,
      "height": 117.6,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "1ded267e6c3b4593"
      ],
      "frameId": "ade42743521a4dc2",
      "roundness": null,
      "seed": 1941,
      "version": 2,
      "versionNonce": 603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790658895521,
      "created": 1790607854110,
      "link": null,
      "locked": false,
      "text": "source_revision = H(可信 scope + 全部词项 / 来源\n+ 文字输入 + 媒体输入身份 + 投影 / 检索 / 编码合同)。\n只改 questions 也改变指纹，必须同步 ES。\n指纹只判相等，不代表新旧顺序；不等于发布版本。",
      "originalText": "source_revision = H(可信 scope + 全部词项 / 来源\n+ 文字输入 + 媒体输入身份 + 投影 / 检索 / 编码合同)。\n只改 questions 也改变指纹，必须同步 ES。\n指纹只判相等，不代表新旧顺序；不等于发布版本。",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.4
