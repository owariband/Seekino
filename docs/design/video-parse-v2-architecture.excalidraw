      "x": 1820,
      "y": 4045,
      "width": 700,
      "height": 255,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fef2f2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
