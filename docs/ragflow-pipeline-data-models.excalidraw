    {
      "id": "cb10138396194366",
      "type": "text",
      "x": 60,
      "y": 803,
      "width": 610.0,
      "height": 112.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
