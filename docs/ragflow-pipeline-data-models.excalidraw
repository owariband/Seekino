      "locked": false,
      "text": "③ 粒度与可靠性各有职责",
      "originalText": "③ 粒度与可靠性各有职责",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
