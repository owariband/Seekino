      "autoResize": true,
      "lineHeight": 1.4
    },
    {
      "id": "9d32b448f8e041c9",
      "type": "text",
      "x": 1530,
      "y": 3278,
      "width": 401.0,
      "height": 117.6,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "3f0d8d35f12b44a0"
      ],
      "frameId": "912a0de31ef14e1b",
      "roundness": null,
      "seed": 1848,
      "version": 1,
      "versionNonce": 510,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790602727485,
      "created": 1790602727485,
      "link": null,
      "locked": false,
      "text": "Chunk 是默认索引与召回单元。\n时间 / 帧是证据定位，不必一帧一个文档。\n沿用 Interval 状态做索引恢复。\nbulk 逐项成功后仍需检查查询可见。",
      "originalText": "Chunk 是默认索引与召回单元。\n时间 / 帧是证据定位，不必一帧一个文档。\n沿用 Interval 状态做索引恢复。\nbulk 逐项成功后仍需检查查询可见。",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.4
