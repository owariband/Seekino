    "boundary_dialogues": [
      {
        "start_seconds": 50400,
        "end_seconds": 61180,
        "description": "比较两次输出后，讲解者总结 ChatGPT 是概率性系统，同一个提示词可以得到多个不同回答，并引出人们构想的提示词示例。",
        "participants": [
          "Andrej Karpathy"
        ],
        "visible_persons": [
          "Andrej Karpathy"
        ],
        "event_type": "DIALOGUE",
        "speaker": "Andrej Karpathy",
        "text_variants": [
          {
            "language": "en",
            "role": "ORIGINAL",
            "text": "So you can see that ChatGPT is a probabilistic system, and for any one prompt, it can give us multiple answers, sort of replying to it. Now, this is just one example of a prompt people have come up with."
          }
        ]
      },
      {
        "start_seconds": 113520,
        "end_seconds": 121660,
        "description": "讲解概括语言模型的工作方式：给定序列的开头，模型续写并得到结果。",
        "participants": [
          "Andrej Karpathy"
        ],
        "visible_persons": [
          "Andrej Karpathy"
        ],
        "event_type": "DIALOGUE",
        "speaker": "Andrej Karpathy",
        "text_variants": [
          {
            "language": "en",
            "role": "ORIGINAL",
            "text": "what it is doing is it is completing the sequence. So I give it the start of a sequence, and it completes the sequence with the outcome."
          }
        ]
      },
      {
        "start_seconds": 178450,
        "end_seconds": 181440,
        "description": "讲解音频继续说明该架构在随后五年中的扩展影响，句子在本片段结束时尚未完成。",
        "participants": [
          "Andrej Karpathy"
        ],
