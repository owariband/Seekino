# Keep empty for same-origin deployments and the Vite development proxy.
VITE_API_BASE_URL=

# Defaults to the tenant used by the local anivag server.
VITE_TENANT_ID=local-default

# Optional remote account/public/personal data connection for localhost development.
# Vite exposes it at /remote; HTTPS is required except for loopback test servers.
ANIVAG_REMOTE_API_URL=
# Must match ANIVAG_AUTH_COOKIE_NAME on the remote server.
ANIVAG_REMOTE_COOKIE_NAME=anivag_auth

# For production only: set the separately deployed remote API/proxy base.
# Leave empty when no remote connection is available.
VITE_REMOTE_API_BASE_URL=
VITE_REMOTE_API_ORIGIN=
